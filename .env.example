# .env.example
# This file is a template. DO NOT put real secrets here.
# Copy this file to .env.local for local development.

# --- SERVER-ONLY SECRETS ---
# MongoDB Connection String (Required for backend runtime)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>"

# Nvidia API Key (Required for backend AI roadmap generation features)
NVIDIA_API_KEY="nvapi-your-key-here"

# --- CLIENT-SAFE VARIABLES (Must start with VITE_) ---
# These variables will be bundled into the frontend application.
# Do not place secrets here.
# VITE_API_URL="/api" # Default is/api in dev proxy.
